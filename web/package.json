    "@luma.gl/core": "9.4",
    "@math.gl/web-mercator": "^4.1.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.71.0",
    "maplibre-gl": "^5.24.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
